generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  PLANNER
  SHOP_FLOOR_OPERATOR
  VIEWER
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  fullName  String
  role      UserRole @default(ADMIN)
  tenantId  String   @default("kepler-default")
  factoryId String   @default("factory-ist-001")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id            Int      @id @default(autoincrement())
  orderNo       String   @unique
  buyerName     String
  productName   String
  totalQuantity Int
  shipmentDate  DateTime
  status        String   @default("PLANNING")
  tenantId      String   @default("kepler-default")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  materials     Material[]
  productionEntries ProductionEntry[]
  qualityEntries QualityEntry[]
  stockLots     StockLot[]
  colorSizes    OrderColorSize[]
}

model OrderColorSize {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id])
  color     String
  size      String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, color, size])
}

model Material {
  id               Int      @id @default(autoincrement())
  orderId          Int
  order            Order    @relation(fields: [orderId], references: [id])
  materialName     String
  materialType     String
  supplierName     String
  orderedQuantity  Float
  orderedDate      DateTime?
  expectedArrival  DateTime?
  arrivedQuantity  Float     @default(0)
  status           String    @default("PENDING")
  fabricWidth      Float?
  fabricWeight     Float?
  unitPrice        Float?
  currency         String?   @default("USD")
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model ProductionEntry {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id])
  stage       String   // CUTTING, SEWING, IRONING, PACKING, SHIPPING
  quantity    Int
  date        DateTime @default(now())
  lineNo      String?  // hat numarası
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QualityEntry {
  id            Int      @id @default(autoincrement())
  orderId       Int
  order         Order    @relation(fields: [orderId], references: [id])
  checkedQty    Int      // kontrol edilen adet
  firstQuality  Int      // 1. kalite adet
  secondQuality Int      // 2. kalite adet
  rejected      Int      // ret/fire adet
  defectType    String?  // hata türü (opsiyonel: dikiş hatası, leke, ölçü sapması vb.)
  date          DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StockLot {
  id              Int      @id @default(autoincrement())
  materialName    String
  materialType    String   // KUMAŞ, AKSESUAR
  supplierName    String
  lotNo           String?
  receivedQty     Float
  remainingQty    Float
  unitPrice       Float?
  currency        String   @default("USD")
  receivedDate    DateTime @default(now())
  orderId         Int?     // hangi siparişin malzemesi olarak geldi (opsiyonel)
  order           Order?   @relation(fields: [orderId], references: [id])
  movements       StockMovement[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model StockMovement {
  id          Int      @id @default(autoincrement())
  stockLotId  Int
  stockLot    StockLot @relation(fields: [stockLotId], references: [id])
  type        String   // GIRIS, CIKIS
  quantity    Float
  reason      String?  // örn: "1040 nolu sipariş kesim için tüketim"
  orderId     Int?     // tüketim hangi sipariş için yapıldı
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}
