generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  PLANNER
  SHOP_FLOOR_OPERATOR
  VIEWER
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  fullName  String
  role      UserRole @default(ADMIN)
  tenantId  String   @default("kepler-default")
  factoryId String   @default("factory-ist-001")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id            Int      @id @default(autoincrement())
  orderNo       String   @unique
  buyerName     String
  productName   String
  totalQuantity Int
  shipmentDate  DateTime
  status        String   @default("PLANNING")
  tenantId      String   @default("kepler-default")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  materials     Material[]
  productionEntries ProductionEntry[]
  qualityEntries QualityEntry[]
  stockLots     StockLot[]
  colorSizes    OrderColorSize[]
  approvalStages ApprovalStage[]
  closedAt      DateTime?
  closedBy      String?

  @@index([tenantId])
}

model ApprovalStage {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id])
  stageType   String   // PP_NUMUNE, PASTAL_ONAY, SARFIYAT_ONAY, KESIM_ONAY
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy  String?
  approvedAt  DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orderId, stageType])
  @@index([orderId])
}

model OrderColorSize {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id])
  color     String
  size      String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, color, size])
  @@index([orderId])
}

model Material {
  id               Int      @id @default(autoincrement())
  orderId          Int
  order            Order    @relation(fields: [orderId], references: [id])
  materialName     String
  materialType     String
  supplierName     String
  orderedQuantity  Float
  orderedDate      DateTime?
  expectedArrival  DateTime?
  arrivedQuantity  Float     @default(0)
  status           String    @default("PENDING")
  fabricWidth      Float?
  fabricWeight     Float?
  unitPrice        Float?
  currency         String?   @default("USD")
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  stockLot         StockLot?

  @@index([orderId])
}

model ProductionEntry {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id])
  stage       String   // CUTTING, SEWING, IRONING, PACKING, SHIPPING
  quantity    Int
  date        DateTime @default(now())
  lineNo      String?  // hat numarası
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
}

model QualityEntry {
  id            Int      @id @default(autoincrement())
  orderId       Int
  order         Order    @relation(fields: [orderId], references: [id])
  checkedQty    Int      // kontrol edilen adet
  firstQuality  Int      // 1. kalite adet
  secondQuality Int      // 2. kalite adet
  rejected      Int      // ret/fire adet
  defectType    String?  // hata türü (opsiyonel: dikiş hatası, leke, ölçü sapması vb.)
  date          DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([orderId])
}

model StockLot {
  id              Int      @id @default(autoincrement())
  code            String?  // kullanıcının kendi girdiği malzeme kodu (opsiyonel)
  materialName    String
  materialType    String   // KUMAŞ, AKSESUAR
  supplierName    String
  lotNo           String?
  receivedQty     Float
  remainingQty    Float
  unitPrice       Float?
  currency        String   @default("USD")
  receivedDate    DateTime @default(now())
  orderId         Int?     // hangi siparişin malzemesi olarak geldi (opsiyonel)
  order           Order?   @relation(fields: [orderId], references: [id])
  materialId      Int?     @unique
  material        Material? @relation(fields: [materialId], references: [id])
  warehouseId     Int?
  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id])
  movements       StockMovement[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId])
  @@index([warehouseId])
}

model ProductionLine {
  id         Int         @id @default(autoincrement())
  name       String      @unique // örn "LINE-1", "LINE-2"
  capacity   Int         @default(0) // günlük hedef üretim kapasitesi (adet)
  tenantId   String      @default("kepler-default")
  warehouses Warehouse[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([tenantId])
}

model Warehouse {
  id        Int             @id @default(autoincrement())
  code      String          @unique // "KMS-01", "AKS-01", "URN-01", "LN1-HM" vb.
  name      String          @unique // "Kumaş Deposu", "Aksesuar Deposu", "Ürün Deposu", "LINE-1 Hammadde Deposu" vb.
  type      String          // KUMAS, AKSESUAR, URUN, ATOLYE_HAMMADDE
  lineId    Int?            // ATOLYE_HAMMADDE tipindeyse hangi ProductionLine'a ait
  line      ProductionLine? @relation(fields: [lineId], references: [id])
  stockLots StockLot[]
  tenantId  String          @default("kepler-default")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([tenantId])
  @@index([lineId])
}

model StockMovement {
  id          Int      @id @default(autoincrement())
  stockLotId  Int
  stockLot    StockLot @relation(fields: [stockLotId], references: [id])
  type        String   // GIRIS, CIKIS
  quantity    Float
  reason      String?  // örn: "1040 nolu sipariş kesim için tüketim"
  orderId     Int?     // tüketim hangi sipariş için yapıldı
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([stockLotId])
  @@index([orderId])
}
